# This repo is public. Work notes stay on this PC only.

# Claude Code settings for this PC (dev servers, company skill)
.claude/

# Obsidian's per-device window state (lists recently opened notes)
memory/LLM/.obsidian/workspace*.json

# Daily notes, project notes and work areas: private
memory/LLM/00_Inbox/*
